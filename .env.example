# Copie com make setup: senhas aleatórias são geradas somente em .env local.
APP_ENV=development
POSTGRES_DB=flagpilot
POSTGRES_USER=flagpilot_migrator
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
DB_PORT=5432
API_PORT=8080
WEB_PORT=5173
HTTP_ADDR=127.0.0.1:8080
# Usuário runtime sem DDL; make setup preenche o valor local.
DATABASE_URL=
LOG_LEVEL=info
DB_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s

# Origem exata do painel; HTTP somente em loopback de desenvolvimento.
PUBLIC_BASE_URL=http://127.0.0.1:5173
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
SESSION_TTL=12h
